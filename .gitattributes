# Line endings: store and check out text files with LF on every OS
# (Windows, macOS, Linux cluster). Overrides each machine's core.autocrlf,
# so the repository looks the same everywhere and diffs show no
# whole-file line-ending changes.
* text=auto eol=lf

# Windows-only scripts keep CRLF, should any be added
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary formats: never convert, never diff as text
*.pdf    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.zip    binary
*.pkl    binary
*.sqsh   binary
*.sif    binary
